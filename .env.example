# Copy to .env and fill in. .env is gitignored; never commit real values.

# PayPal sandbox app: developer.paypal.com > Apps & Credentials > Sandbox > your app
# (tick "Customer disputes" and "Save payment methods" on the app)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Sandbox business account's Account ID: Testing Tools > Sandbox Accounts > business account > View/Edit
PAYPAL_MERCHANT_ID=

# The US buyer's saved PayPal wallet (Vault v3 payment token). Get it once from the Shopper agent page
# ("Connect shopper wallet"), approving as the US personal sandbox account.
SHOPPER_VAULT_TOKEN=

# Model: any OpenAI-compatible endpoint. Groq free tier works (one hearing is ~7 calls, ~2 minutes with rate-limit waits).
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-120b
LLM_API_KEY=
LLM_JSON_MODE=strict

# Fallback model (a second Groq model has its own rate limit). Leave the URL empty to disable.
FALLBACK_LLM_BASE_URL=https://api.groq.com/openai/v1
FALLBACK_LLM_MODEL=openai/gpt-oss-20b
FALLBACK_LLM_API_KEY=
FALLBACK_LLM_JSON_MODE=strict

# Local model instead (llama.cpp): LLM_BASE_URL=http://localhost:8080/v1  LLM_MODEL=qwen3-4b  LLM_API_KEY=local
